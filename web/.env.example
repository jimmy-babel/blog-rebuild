OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=
TEXT_MODEL=gpt-5.6-luna
IMAGE_MODEL=gpt-image-2

# edits：copy/rebuild 都把参考图发给图片编辑接口；generations：只发提示词
IMAGE_API_MODE=edits
# 某些 OpenAI-compatible 服务使用 image 而不是 image[]
IMAGE_EDIT_FIELD=image[]
AI_TIMEOUT_SECONDS=900

N8N_WEBHOOK_URL=http://localhost:5678/webhook/wechat-article-extractor
BLOG_ROOT=E:/JIMMY/AI-Proj/blog
MAX_CONCURRENT_TASKS=2
