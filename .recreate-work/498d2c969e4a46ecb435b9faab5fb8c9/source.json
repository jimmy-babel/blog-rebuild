      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 24,
      "text": "顺而不从的精髓：",
      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 25,
      "text": "嘴上答应得快",
      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 26,
      "text": "行动拐弯得快",
      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 27,
      "text": "她高兴了",
      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 28,
      "text": "我也自由了",
      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 29,
      "text": "两全其美",
      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 30,
      "text": "这叫双赢",
      "boundary": "body"
