      "text": "01",
      "boundary": "head"
    },
    {
      "type": "text",
      "sourceIndex": 5,
      "text": "她非要给孩子穿三层",
      "boundary": "head"
    },
    {
      "type": "text",
      "sourceIndex": 6,
      "text": "我说“妈你真细心”",
      "boundary": "head"
    },
    {
      "type": "text",
      "sourceIndex": 7,
      "text": "出门就给娃脱了一件",
      "boundary": "head"
    },
    {
      "type": "text",
      "sourceIndex": 8,
      "text": "回来再穿上",
      "boundary": "head"
    },
    {
      "type": "text",
      "sourceIndex": 9,
      "text": "她摸摸娃后背说“没出汗”",
      "boundary": "head"
    },
    {
      "type": "text",
      "sourceIndex": 10,
      "text": "我说“妈你真有经验”",
      "boundary": "body"
    },
    {
      "type": "text",
      "sourceIndex": 11,
      "text": "她得意了",
      "boundary": "body"
    },
